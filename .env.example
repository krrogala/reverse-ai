# Copy to .env and fill in ONE of the blocks below. Never commit .env.

# --- Claude Code CLI (default). Create the token with: claude setup-token
REVERSE_AI_PROVIDER=claude-cli
CLAUDE_CODE_OAUTH_TOKEN=
# REVERSE_AI_MODEL=sonnet

# --- Claude API
# REVERSE_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# REVERSE_AI_MODEL=claude-opus-5-5

# --- OpenAI API (REVERSE_AI_MODEL is required)
# REVERSE_AI_PROVIDER=openai
# OPENAI_API_KEY=
# REVERSE_AI_MODEL=

# --- Gemini API (REVERSE_AI_MODEL is required)
# REVERSE_AI_PROVIDER=gemini
# GEMINI_API_KEY=
# REVERSE_AI_MODEL=

# --- OpenRouter (REVERSE_AI_MODEL is required, in vendor/model form)
# REVERSE_AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# REVERSE_AI_MODEL=

# Extra Host headers to accept, comma separated, when the console is reached by
# a name or port other than localhost:4517 (for example behind a reverse proxy).
# REVERSE_AI_ALLOWED_HOSTS=human1.example.com
